# Runtime configuration for `docker compose up -d --build` (Postgres +
# backend + frontend, all three, one command).
#
# Copy this file to .env (gitignored, never commit real secrets there)
# before running Docker Compose:
#   cp .env.example .env
#   docker compose up -d --build
#   docker compose down
#
# docker compose automatically loads a file named exactly `.env` in this
# directory, both to substitute `${VARS}` inside docker-compose.yml itself
# and (via each service's own `env_file:`) to set the actual container
# environment -- one file, no manual `export` commands needed.

# --- PostgreSQL (pgvector) ---
POSTGRES_USER=readmatch
POSTGRES_PASSWORD=readmatch
POSTGRES_DB=readmatch
# Host-side port Postgres is reachable at outside Docker (e.g. a local
# `psql`/GUI client). The backend never uses this port -- see DATABASE_URL
# below, which talks to Postgres over the internal Docker network instead.
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
# "postgres" is this compose file's Postgres service name, and 5432 is
# Postgres's fixed internal container port -- not POSTGRES_PORT above,
# which is only the host-side mapping. Only meaningful when
# BOOK_REPOSITORY_BACKEND=postgresql (below); ignored for in_memory.
DATABASE_URL=postgresql://readmatch:readmatch@postgres:5432/readmatch
# in_memory (no persistence, no Postgres needed) or postgresql.
BOOK_REPOSITORY_BACKEND=postgresql
APPLICATION_MODE=development
# deterministic (dependency-free placeholder) or sentence_transformers.
EMBEDDING_GENERATOR_BACKEND=deterministic
# weighted (Weighted Score Fusion) or rrf (Reciprocal Rank Fusion).
HYBRID_RANKING_STRATEGY=weighted
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Host-side port the API is reachable at: http://localhost:$BACKEND_PORT.
BACKEND_PORT=8000

# --- Frontend (Next.js) ---
# Read by the browser (client-side code) -- must be the host-mapped
# address, since the browser runs on your machine, not inside Docker.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Read only by the frontend's own server-side rendering, inside its
# container -- must be the backend's Docker Compose service name plus its
# fixed internal port (8000), since "localhost" inside the frontend
# container refers to the frontend container itself, not the backend.
# Never sent to the browser (no NEXT_PUBLIC_ prefix).
API_BASE_URL_INTERNAL=http://backend:8000
# Host-side port the frontend is reachable at: http://localhost:$FRONTEND_PORT.
FRONTEND_PORT=3000
